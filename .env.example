# Returns Reason Hotspot Dashboard — database credentials
#
#   cp .env.example .env      then fill in the real password below.
#
# .env is gitignored. Never commit it, and never put real credentials in
# .env.example — this file IS committed.
#
# Data source: LEDSone PostgreSQL (migrated 2026-09-14). TLS is required.

# Dashboard DATA source (returns/listings queries) — LEDSone.
PGHOST=169.58.91.229
PGPORT=5432
PGDATABASE=ledsone
PGUSER=tech_user
PGPASSWORD=your_password_here
PGSSLMODE=require

# Hub PUBLISH target — the database that holds varman_aios.hub_pages (read by the
# Varman AIOS Hub site). This is a DIFFERENT database from the data source above;
# scripts/refresh_and_publish.sh uses these for stage 2 only. Placeholder here.
HUB_PGHOST=your_hub_db_host
HUB_PGPORT=5432
HUB_PGDATABASE=your_hub_db_name
HUB_PGUSER=your_hub_db_user
HUB_PGPASSWORD=your_hub_db_password
